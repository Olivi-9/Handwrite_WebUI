# syntax=docker/dockerfile:1.6
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libjpeg62-turbo \
    zlib1g \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY backend /app/backend
COPY ttf /app/ttf
COPY background /app/background
COPY --chmod=755 scripts/run_backend_container.sh /app/scripts/run_backend_container.sh

RUN mkdir -p /app/backend/static/uploads \
    /app/backend/static/output \
    /app/backend/logs

EXPOSE 8000

# Plain HTTP only: TLS is terminated by Cloudflare Tunnel in front of this service.
ENV BACKEND_HOST=0.0.0.0 \
    BACKEND_PORT=8000

CMD ["/app/scripts/run_backend_container.sh"]
