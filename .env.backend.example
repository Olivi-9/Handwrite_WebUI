# ============================================================
# Backend environment variables (example)
# Copy to .env (or .env.backend.local) and edit before running:
#   ./scripts/run_backend_https.sh
# Anything pre-set in the shell environment takes precedence
# over values in these files.
# ============================================================

# --- Application secrets ---
# Required. At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET_KEY="replace-with-at-least-32-chars"

# Required. Comma-separated list of frontend origins that may call the API.
# Wildcards are not allowed.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- HTTPS server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8443
# Used to locate Let's Encrypt live certs under
#   ${LETSENCRYPT_DIR}/live/${BACKEND_DOMAIN}/
BACKEND_DOMAIN=localhost

# --- Certificate source (pick ONE; resolved in this priority order) ---

# 1) Manual certificate paths (highest priority)
# BACKEND_SSL_CERT_FILE=./certs/local/localhost.crt
# BACKEND_SSL_KEY_FILE=./certs/local/localhost.key

# 2) Let's Encrypt directory layout
LETSENCRYPT_DIR=./certs/letsencrypt
LETSENCRYPT_DOMAIN=example.com
ETSENCRYPT_EMAIL=admin@example.com

# 3) Local development certificate (lowest priority; must already exist)
# LOCAL_CERT_DIR=./certs/local
# LOCAL_CERT_FILE=./certs/local/localhost.crt
# LOCAL_KEY_FILE=./certs/local/localhost.key

# --- Let's Encrypt issuance (used by scripts/backend_issue_cert.sh) ---
# CERTBOT_WEBROOT=./certs/www

# --- Python runtime (local non-Docker only) ---
# BACKEND_VENV_DIR=./.venv

# --- Logging ---
# BACKEND_LOG_LEVEL=INFO
# BACKEND_LOG_DIR=./backend/logs
# BACKEND_LOG_FILE=backend.log
# BACKEND_LOG_MAX_BYTES=10485760
# BACKEND_LOG_BACKUP_COUNT=5

# --- Cleanup loop ---
# CLEANUP_INTERVAL_SECONDS=1200
# FILE_RETENTION_SECONDS=1200

# --- Worker pool ---
# HANDWRITE_WORKERS=4
